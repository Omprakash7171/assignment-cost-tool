# Copy to .env (or export in your shell) to override the development defaults.
# The application runs without any of these set; the fallbacks are for local
# development only and must not be used in production.

# Django signing key — generate a new one per environment, e.g. with
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=dev-only-insecure-key-not-for-production

# "1" enables debug (default), "0" enables production security hardening
# (HTTPS redirect, secure cookies, HSTS)
DJANGO_DEBUG=1

# Comma-separated hostnames allowed to reach the app
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
